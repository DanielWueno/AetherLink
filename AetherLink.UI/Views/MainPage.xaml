<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AetherLink.UI.Views.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:AetherLink.UI.ViewModels"
    xmlns:models="clr-namespace:AetherLink.Core.Models;assembly=AetherLink.Core"
    xmlns:converters="clr-namespace:AetherLink.UI.Converters"
    Title="WinDiagnostic Helper"
    BackgroundColor="#0D1117">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InvertBoolConverter x:Key="InvertBoolConverter" />

            <!-- ── Color Palette ────────────────────────────────────────── -->
            <Color x:Key="SurfaceColor">#0D1117</Color>
            <Color x:Key="SurfaceElevatedColor">#161B22</Color>
            <Color x:Key="BorderColor">#21262D</Color>
            <Color x:Key="TextPrimary">#C9D1D9</Color>
            <Color x:Key="TextSecondary">#8B949E</Color>
            <Color x:Key="AccentTeal">#3FB950</Color>
            <Color x:Key="AccentAmber">#D29922</Color>

            <!-- ── Styles ────────────────────────────────────────────────── -->
            <Style x:Key="CardFrame" TargetType="Border">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="Stroke" Value="{StaticResource BorderColor}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape" Value="RoundRectangle 8" />
                <Setter Property="Padding" Value="16" />
                <Setter Property="Margin" Value="0,6" />
            </Style>

            <Style x:Key="SectionLabel" TargetType="Label">
                <Setter Property="FontFamily" Value="InterSemiBold" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
                <Setter Property="TextTransform" Value="Uppercase" />
            </Style>

            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="FontFamily" Value="InterSemiBold" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
                <Setter Property="BackgroundColor" Value="{StaticResource SurfaceElevatedColor}" />
                <Setter Property="BorderColor" Value="{StaticResource BorderColor}" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="HeightRequest" Value="40" />
            </Style>

            <Style x:Key="SecondaryButton" TargetType="Button">
                <Setter Property="FontFamily" Value="Inter" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="BorderColor" Value="{StaticResource BorderColor}" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="HeightRequest" Value="36" />
            </Style>

        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <Grid
            RowDefinitions="Auto,*,Auto"
            Padding="24,20,24,20"
            RowSpacing="0">

            <!-- ══ HEADER ═══════════════════════════════════════════════ -->
            <Grid
                Grid.Row="0"
                ColumnDefinitions="Auto,*,Auto"
                Margin="0,0,0,16">

                <VerticalStackLayout Grid.Column="0" Spacing="0">
                    <Label FontFamily="InterBold" FontSize="18" TextColor="{StaticResource TextPrimary}" Text="WinDiagnostic Helper" />
                    <Label FontFamily="Inter" FontSize="11" TextColor="{StaticResource TextSecondary}" Text="Local hardware diagnostics bridge" />
                </VerticalStackLayout>

                <!-- Status indicator -->
                <HorizontalStackLayout Grid.Column="2" Spacing="6" VerticalOptions="Center">
                    <Ellipse WidthRequest="8" HeightRequest="8" VerticalOptions="Center" Fill="{Binding StatusIndicatorColor}" />
                    <Label Text="{Binding CurrentState}" FontFamily="Inter" FontSize="11" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Grid>

            <!-- ══ CONTENT ══════════════════════════════════════════════ -->
            <VerticalStackLayout Grid.Row="1" Spacing="4">

                <!-- ─ CARD 1: Device & Connection ───────────────────────── -->
                <Border Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="16">

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                            <Label Grid.Column="0" Style="{StaticResource SectionLabel}" Text="Device Selection" VerticalOptions="Center" />
                            <Button Grid.Column="1" Text="Scan" Style="{StaticResource SecondaryButton}" WidthRequest="70" Command="{Binding ScanDevicesCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBoolConverter}}" />
                        </Grid>

                        <Picker
                            x:Name="DevicePicker"
                            Title="Select a connected Android device"
                            TitleColor="{StaticResource TextSecondary}"
                            TextColor="{StaticResource TextPrimary}"
                            BackgroundColor="Transparent"
                            FontSize="13"
                            HeightRequest="40"
                            ItemsSource="{Binding Devices}"
                            SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                            ItemDisplayBinding="{Binding DisplayLabel}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBoolConverter}}" />

                        <Button
                            x:Name="ConnectButton"
                            Style="{StaticResource PrimaryButton}"
                            Text="{Binding ConnectButtonLabel}"
                            Command="{Binding ConnectTunnelCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBoolConverter}}" />

                        <ActivityIndicator
                            IsRunning="{Binding IsBusy}"
                            IsVisible="{Binding IsBusy}"
                            Color="{StaticResource AccentTeal}"
                            HeightRequest="20"
                            HorizontalOptions="Center" />

                    </VerticalStackLayout>
                </Border>

                <!-- ─ CARD 2: Tools & Terminal ──────────────────────── -->
                <Border Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="16">

                        <Label Style="{StaticResource SectionLabel}" Text="Proxy Tools" />

                        <!-- Env var preview when connected -->
                        <VerticalStackLayout IsVisible="{Binding IsConnected}" Spacing="2">
                            <Label Text="HTTP_PROXY=http://127.0.0.1:1080" FontFamily="InterMono" FontSize="11" TextColor="{StaticResource AccentTeal}" />
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                            <Button
                                Grid.Column="0"
                                Style="{StaticResource SecondaryButton}"
                                Text="Open Terminal"
                                Command="{Binding LaunchTerminalCommand}"
                                IsEnabled="{Binding IsConnected}" />

                            <Button
                                Grid.Column="1"
                                Style="{StaticResource SecondaryButton}"
                                Text="Test Connection"
                                Command="{Binding TestConnectionCommand}"
                                IsEnabled="{Binding IsConnected}" />
                            
                            <Button
                                Grid.Column="2"
                                Style="{StaticResource SecondaryButton}"
                                Text="Hide to Tray"
                                Clicked="OnHideButtonClicked" />
                        </Grid>

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>

            <!-- ══ STATUS BAR ═══════════════════════════════════════════ -->
            <Label
                Grid.Row="2"
                Margin="0,16,0,0"
                Text="{Binding StatusMessage}"
                FontFamily="Inter" FontSize="11"
                TextColor="{StaticResource TextSecondary}"
                LineBreakMode="TailTruncation"
                HorizontalOptions="Center" />

        </Grid>
    </ScrollView>
</ContentPage>
