<?xml version="1.0" encoding="UTF-8" ?>
<Application
    x:Class="AetherLink.UI.App"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:AetherLink.UI.Converters">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Global converter registration so XAML can resolve {StaticResource InvertBoolConverter} -->
            <converters:InverseBoolConverter x:Key="InvertBoolConverter" />
        </ResourceDictionary>
    </Application.Resources>

</Application>
