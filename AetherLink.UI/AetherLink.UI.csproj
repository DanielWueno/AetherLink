<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0-windows10.0.19041.0;net10.0-maccatalyst</TargetFrameworks>
    <RootNamespace>AetherLink.UI</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>

    <!-- Application identity -->
    <ApplicationTitle>AetherLink</ApplicationTitle>
    <ApplicationId>com.dsoft03.aetherlink</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>

    <!-- Windows: run as unpackaged MSIX for easier development -->
    <WindowsPackageType>None</WindowsPackageType>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.19041.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <!-- ── Bundled ADB binaries (portable, no SDK install required) ─────── -->
  <!-- These are copied from the Aether base project (adb 1.0.40 / Oct 2018) -->
  <ItemGroup>
    <None Update="adb\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- ── MAUI Resources ───────────────────────────────────────────────── -->
  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg"
              ForegroundFile="Resources\AppIcon\appiconfg.svg"
              Color="#0D1117" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg"
                      Color="#0D1117" BaseSize="128,128" />

    <!-- Inter + JetBrains Mono — download and place in Resources\Fonts\ -->
    <MauiFont Include="Resources\Fonts\Inter-Regular.ttf" />
    <MauiFont Include="Resources\Fonts\Inter-SemiBold.ttf" />
    <MauiFont Include="Resources\Fonts\Inter-Bold.ttf" />
    <MauiFont Include="Resources\Fonts\JetBrainsMono-Regular.ttf" />
  </ItemGroup>

  <!-- ── NuGet Packages ───────────────────────────────────────────────── -->
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm"  Version="8.4.0" />
    <PackageReference Include="CommunityToolkit.Maui"  Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
  </ItemGroup>

  <!-- ── Project References ───────────────────────────────────────────── -->
  <ItemGroup>
    <ProjectReference Include="..\AetherLink.Core\AetherLink.Core.csproj" />
  </ItemGroup>

</Project>
